# Server
NODE_ENV=development
PORT=5050

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Where research sign-ups are appended (JSON Lines). Relative to the server package.
SIGNUPS_FILE=data/signups.jsonl

# Optional outbound webhook (Slack, Zapier, CRM…) for new sign-ups
SIGNUP_WEBHOOK_URL=
